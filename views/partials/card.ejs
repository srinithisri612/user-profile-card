<%
  const cardTheme = profile.theme || 'dark-glass';
  const name = profile.full_name || 'Anonymous Creator';
  const headline = profile.headline || 'Full-Stack Developer';
  const bio = profile.bio || 'Passionate developer crafting modern, responsive web experiences.';
  const readingTime = profile.reading_time || '10s read';
  const skills = Array.isArray(profile.skills) ? profile.skills : [];
  const social = profile.social_links || {};
  const isPrev = typeof isPreview !== 'undefined' && isPreview;
%>

<div class="card-perspective-wrapper" data-theme="<%= cardTheme %>">
  <article class="profile-card theme-<%= cardTheme %>" id="card-<%= profile.slug || 'preview' %>">
    
    <!-- Top Decorative Banner -->
    <div class="card-banner"></div>

    <!-- Header: Avatar + Top Pills -->
    <div class="card-header-area">
      <div class="avatar-frame">
        <img 
          src="<%= profile.avatar_url || 'https://api.dicebear.com/7.x/bottts/svg?seed=' + encodeURIComponent(name) %>" 
          alt="<%= name %> Avatar"
          class="profile-avatar-img"
          loading="lazy"
          onerror="this.onerror=null; this.src='https://api.dicebear.com/7.x/identicon/svg?seed=fallback';"
        >
        <span class="avatar-status-dot" title="Active Developer"></span>
      </div>

      <div class="card-top-badges">
        <span class="verified-pill">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          Verified
        </span>
        <span class="read-time-pill" title="Estimated reading time">
          ⏱️ <%= readingTime %>
        </span>
      </div>
    </div>

    <!-- User Information -->
    <div class="profile-info">
      <h2 class="profile-name">
        <%= name %>
      </h2>
      <p class="profile-headline"><%= headline %></p>
      
      <p class="profile-bio"><%= bio %></p>

      <!-- Extracted Hashtags if any -->
      <% 
        const bioText = bio || '';
        const foundTags = bioText.match(/#[a-zA-Z0-9_]+/g) || [];
      %>
      <% if (foundTags.length > 0) { %>
        <div class="bio-hashtags">
          <% foundTags.forEach(tag => { %>
            <span class="bio-tag"><%= tag %></span>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- Skills Cloud Section -->
    <% if (skills && skills.length > 0) { %>
      <div class="skills-section">
        <div class="card-section-label">Core Competencies & Stack</div>
        <div class="skills-cloud">
          <% skills.forEach(skill => { %>
            <span class="skill-badge <%= skill.colorClass || 'badge-violet' %>">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="12" cy="12" r="10"></circle>
              </svg>
              <%= typeof skill === 'object' ? skill.name : skill %>
            </span>
          <% }); %>
        </div>
      </div>
    <% } %>

    <!-- Social Links Row -->
    <% 
      const hasSocial = social.github || social.linkedin || social.twitter || social.website || social.email;
    %>
    <% if (hasSocial) { %>
      <div class="social-links-area">
        <!-- GitHub -->
        <% if (social.github) { %>
          <a href="<%= social.github.url %>" target="_blank" rel="noopener noreferrer" class="social-button" title="GitHub: <%= social.github.handle %>">
            <svg viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span><%= social.github.handle %></span>
          </a>
        <% } %>

        <!-- LinkedIn -->
        <% if (social.linkedin) { %>
          <a href="<%= social.linkedin.url %>" target="_blank" rel="noopener noreferrer" class="social-button" title="LinkedIn: <%= social.linkedin.handle %>">
            <svg viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span>LinkedIn</span>
          </a>
        <% } %>

        <!-- Twitter / X -->
        <% if (social.twitter) { %>
          <a href="<%= social.twitter.url %>" target="_blank" rel="noopener noreferrer" class="social-button" title="X (Twitter): <%= social.twitter.handle %>">
            <svg viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span><%= social.twitter.handle %></span>
          </a>
        <% } %>

        <!-- Website -->
        <% if (social.website) { %>
          <a href="<%= social.website.url %>" target="_blank" rel="noopener noreferrer" class="social-button" title="Portfolio: <%= social.website.handle %>">
            <svg viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/>
              <line x1="2" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="2"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" fill="none" stroke="currentColor" stroke-width="2"/>
            </svg>
            <span><%= social.website.handle %></span>
          </a>
        <% } %>

        <!-- Email -->
        <% if (social.email) { %>
          <a href="<%= social.email.url %>" class="social-button" title="Contact Email">
            <svg viewBox="0 0 24 24">
              <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            <span>Email</span>
          </a>
        <% } %>
      </div>
    <% } %>

    <!-- Footer Bar -->
    <div class="card-footer-bar">
      <div class="card-signature">
        ⚡ ProfileForge Card
      </div>
      <div>
        <% if (profile.slug && !isPrev) { %>
          <a href="/p/<%= profile.slug %>" style="color: var(--card-accent, #38bdf8); text-decoration: none; font-weight: 600;">
            View Permalink &rarr;
          </a>
        <% } else { %>
          <span><%= profile.word_count || 0 %> words</span>
        <% } %>
      </div>
    </div>

  </article>
</div>
