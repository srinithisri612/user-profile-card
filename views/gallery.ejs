<%- include('partials/header') %>

<main class="container" style="padding: 40px 24px 80px;">

  <!-- Gallery Header -->
  <div style="display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-bottom: 32px;">
    <div>
      <div class="hero-pill" style="margin-bottom: 8px;">
        <span>SQLite Persistent Storage</span>
      </div>
      <h1 style="font-family: var(--font-heading); font-size: 2.25rem; font-weight: 800; letter-spacing: -0.02em;">
        Dynamic Profile <span class="gradient-text">Card Showcase</span>
      </h1>
      <p style="color: var(--text-muted); font-size: 1rem; margin-top: 6px;">
        Explore all generated developer and creator cards stored in the database.
      </p>
    </div>

    <div>
      <a href="/" class="btn-primary" id="btn-create-new-gallery">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Create New Card
      </a>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div style="background: var(--bg-glass); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid var(--border-glass); border-radius: var(--radius-lg); padding: 18px 24px; margin-bottom: 36px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
    
    <form action="/gallery" method="GET" style="display: flex; gap: 10px; flex: 1; max-width: 500px;">
      <div class="input-wrapper" style="flex: 1;">
        <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          name="q" 
          class="form-control has-icon" 
          placeholder="Search by name, role, skill, or keyword..." 
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
        >
      </div>
      <button type="submit" class="btn-secondary" style="padding: 10px 18px;">
        Search
      </button>
      <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
        <a href="/gallery" class="btn-secondary" style="padding: 10px 14px;" title="Clear search">✕</a>
      <% } %>
    </form>

    <div style="font-size: 0.9rem; color: var(--text-muted);">
      Total Profiles in DB: <strong style="color: #fff;"><%= profiles.length %></strong>
    </div>

  </div>

  <!-- Gallery Grid -->
  <% if (profiles && profiles.length > 0) { %>
    <div class="gallery-grid">
      <% profiles.forEach(cardProfile => { %>
        <div style="display: flex; flex-direction: column;">
          <%- include('partials/card', { profile: cardProfile, isPreview: false }) %>
          <div style="display: flex; gap: 8px; margin-top: 10px; justify-content: flex-end;">
            <a href="/p/<%= cardProfile.slug %>" class="btn-secondary" style="font-size: 0.78rem; padding: 5px 12px;">
              🔗 Direct Permalink
            </a>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div style="text-align: center; padding: 60px 20px; background: var(--bg-glass); border: 1px dashed var(--border-glass); border-radius: var(--radius-xl); max-width: 600px; margin: 40px auto;">
      <div style="font-size: 2.5rem; margin-bottom: 12px;">🔍</div>
      <h3 style="font-family: var(--font-heading); font-size: 1.3rem; margin-bottom: 8px;">No Profile Cards Found</h3>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 20px;">
        <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
          No records matched your search query "<%= searchQuery %>".
        <% } else { %>
          The database currently has no stored profile records.
        <% } %>
      </p>
      <a href="/" class="btn-primary">Generate Your First Card</a>
    </div>
  <% } %>

</main>

<%- include('partials/footer') %>
